ENVIRONMENT=development
POSTGRES_USER=disciply
POSTGRES_PASSWORD=
POSTGRES_DB=disciply
DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=disciply-api
JWT_AUDIENCE=disciply-web
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:8000"]
ACCESS_SECONDS=600
REFRESH_SECONDS=2592000
MAX_BODY_BYTES=16384
AUTH_ATTEMPTS_PER_MINUTE=20
# TEST_DATABASE_URL=postgresql+asyncpg://disciply_test_user:password@localhost:5432/disciply_test



# Optional external AI. An empty key keeps the local rules fallback.
AI_ENABLED=false
AI_PROVIDER_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=8
AI_DAILY_REQUESTS=20
AI_DAILY_TOKENS=24000
AI_MAX_OUTPUT_TOKENS=256
